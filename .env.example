# Kopieren nach ".env" (im selben Ordner wie run.py) und Werte anpassen.
# Diese Datei selbst NICHT mit echten Zugangsdaten ins Git-Repo committen.

# Pfad zum lokal per SFTP gemounteten Musik-Ordner
MUSIC_ROOT=/mnt/musikcloud

# Optional: wo der Such-Index liegt (Default: app/library.db)
# DATABASE_PATH=/var/lib/musikinterface/library.db

# AzuraCast-Anbindung für den "Neu einlesen"-Button
AZURACAST_BASE_URL=https://radio.eure-domain.de
AZURACAST_API_KEY=euer-azuracast-api-key
AZURACAST_STATION_ID=1

# Flask Session-Secret - beliebiger langer Zufallsstring
SECRET_KEY=bitte-aendern-langer-zufallsstring
